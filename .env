# LLM used for query understanding + tool selection (OpenAI-compatible endpoint).
# Groq hosts gpt-oss-120b free: https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# Optional: Telegram alert pushes. Create a bot via @BotFather, put token + chat id here.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# How often (minutes) the alert engine rescans saved locations
ALERT_INTERVAL_MIN=15

# Notify only for severity >= this (info, advisory, watch, warning)
ALERT_MIN_SEVERITY=watch